{
	"name": "experience-ui",
	"description": "Reference Experience Layer web client for OpenAgriNet",
	"version": "0.0.0",
	"engines": {
		"node": ">=20"
	},
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OpenAgriNet/experience-ui.git"
	},
	"type": "module",
	"packageManager": "npm@11.3.0",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"knip": "knip --include files,dependencies,unlisted,unresolved",
		"preview": "vite preview",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"prepare": "husky",
		"typecheck": "tsc -b",
		"lint:fix": "eslint . --fix"
	},
	"dependencies": {
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-slot": "^1.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/react-query": "^5.103.2",
		"@tanstack/react-router": "1.153.2",
		"@tanstack/virtual-file-routes": "^1.162.0",
		"axios": "^1.20.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"eslint-config-prettier": "^10.1.8",
		"lottie-react": "^2.4.2",
		"lucide-react": "^0.562.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.7.0",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^9.39.5",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@tanstack/react-query-devtools": "^5.103.2",
		"@tanstack/react-router-devtools": "1.153.2",
		"@tanstack/router-plugin": "1.153.2",
		"@types/node": "^25.9.8",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"@vitest/coverage-v8": "^5.0.1",
		"autoprefixer": "^10.6.1",
		"baseline-browser-mapping": "^2.11.25",
		"caniuse-lite": "^1.0.30001810",
		"cssnano": "^7.1.9",
		"eslint": "^9.39.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.4.26",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"globals": "^16.5.0",
		"happy-dom": "^20.14.5",
		"husky": "^9.1.7",
		"knip": "^6.37.0",
		"postcss": "^8.5.28",
		"prettier": "^3.9.8",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^7.3.6",
		"vite-plugin-node-polyfills": "^0.24.0",
		"vite-tsconfig-paths": "^6.1.1",
